# The schemas are the published contracts of the N-DOS standard, and the two
# guides are how anyone learns to use it. A source distribution that omitted
# them would ship the implementation without the thing it implements.
include LICENSE NOTICE CITATION.cff
include README.md QUICKSTART.md RECIPES.md LEGACY.md SPECIFICATION.md
recursive-include schemas *.json
recursive-include tests *.py
include .github/workflows/tests.yml

# No working files.
global-exclude *.pyc __pycache__ .DS_Store
